{
  "resolution": [1920, 1080],
  "fps": 60,
  "duration": 30.0,
  "output": "output.mp4",
  "audio_clips": [
    {
      "id": "background-music",
      "path": "assets/song.mp3",
      "track": 0,
      "start_time": 0.0,
      "end_time": 30.0,
      "volume": 1.0
    }
  ],
  "items": [
    {
      "id": "background",
      "type": "image",
      "path": "assets/cover.png",
      "track": 0,
      "start_time": 0.0,
      "end_time": 30.0,
      "z_index": 0,
      "sizing": { "FitRect": { "x": 0, "y": 0, "w": 1920, "h": 1080, "mode": "Cover" } },
      "pivot": [0.5, 0.5],
      "animations": [
        {
          "property": "scale_x",
          "keyframes": [
            { "time": 0.0, "value": 1.0, "easing": "Linear" },
            { "time": 30.0, "value": 1.3, "easing": "Linear" }
          ]
        },
        {
          "property": "scale_y",
          "keyframes": [
            { "time": 0.0, "value": 1.0, "easing": "Linear" },
            { "time": 30.0, "value": 1.3, "easing": "Linear" }
          ]
        },
        {
          "property": "translate_x",
          "keyframes": [
            { "time": 0.0, "value": 0.0, "easing": "SineInOut" },
            { "time": 30.0, "value": -200.0, "easing": "SineInOut" }
          ]
        },
        {
          "property": "opacity",
          "keyframes": [
            { "time": 0.0, "value": 0.0, "easing": "SineInOut" },
            { "time": 3.0, "value": 1.0, "easing": "SineInOut" },
            { "time": 27.0, "value": 1.0, "easing": "SineInOut" },
            { "time": 30.0, "value": 0.0, "easing": "SineInOut" }
          ]
        }
      ]
    }
  ]
}
